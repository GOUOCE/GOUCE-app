# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=smv
DATABASE_URL=postgresql://postgres:SUA_SENHA@postgres:5432/smv

# Redis (fila de jobs de análise)
REDIS_URL=redis://redis:6379/0


# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=smp-fotos
MINIO_USE_SSL=false

# JWT
SECRET_KEY_JWT=
ALGORITHM=HS256

# Aplicação
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# E-mail (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=